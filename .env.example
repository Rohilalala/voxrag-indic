# Copy to .env and fill in. Every setting is optional except the STT key.
# All settings are defined in src/voxrag/config.py; the VOXRAG_ prefix is required.

# ---- REQUIRED for voice input ------------------------------------------------------------
# Sarvam covers 22 Indian languages, which is why it is the primary provider for this corpus.
# Sign up at https://www.sarvam.ai -- free credits on signup, STT is ~Rs 30/hour.
VOXRAG_SARVAM_API_KEY=

# ---- speech to text ----------------------------------------------------------------------
VOXRAG_STT_PROVIDER=sarvam              # sarvam | elevenlabs | local
VOXRAG_STT_FALLBACK_PROVIDER=local      # used when the primary times out; needs no key
# VOXRAG_SARVAM_MODEL=saaras:v3         # NOT "saarika" -- verified against the live API
# VOXRAG_ELEVENLABS_API_KEY=

# ---- vector store ------------------------------------------------------------------------
# MUST point at a real Qdrant server for any latency claim. Embedded/local Qdrant silently
# performs brute-force exact search and ignores both HNSW ef and payload indexes.
#   docker compose up -d
VOXRAG_QDRANT_URL=http://127.0.0.1:6333
VOXRAG_QDRANT_COLLECTION=msmarco_xi14
# VOXRAG_VECTOR_STORE=qdrant            # qdrant | hnsw

# ---- generation --------------------------------------------------------------------------
VOXRAG_DEFAULT_MODE=fast                # fast (extractive, <200ms) | quality (gemma4:e4b)
# VOXRAG_OLLAMA_BASE_URL=http://127.0.0.1:11434
# VOXRAG_OLLAMA_MODEL=gemma4:e4b
# gemma4 is a reasoning model: leaving thinking ON makes it spend the whole token budget on
# hidden reasoning and return an EMPTY answer. Keep this false.
# VOXRAG_OLLAMA_THINK=false
# Hosted generator for a CPU-only deployment, where a 9.6GB local model is not viable.
# VOXRAG_HOSTED_GENERATOR_URL=
# VOXRAG_HOSTED_GENERATOR_KEY=

# ---- indexing ----------------------------------------------------------------------------
# Raise for bulk indexing (roughly doubles throughput, no effect on query latency).
# VOXRAG_EMBED_THREADS=10
# doc2query-style expansion. Leave FALSE for any evaluation: MSMARCO-XI's source_query IS the
# graded query, so indexing it leaks the answer key (Recall@10 went 0.764 -> 0.996).
# VOXRAG_METADATA_INCLUDE_SOURCE_QUERY=false

# ---- server ------------------------------------------------------------------------------
# VOXRAG_HOST=0.0.0.0
# VOXRAG_PORT=8000
# VOXRAG_LOG_LEVEL=INFO
